    <content><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/ensml.dtd">
<en-note><h1>Overview</h1><div>This is a <b>bold</b> and <i>italic</i> and <s>struck</s> line.</div><div>Check the <a href="https://example.com/docs">docs</a>.</div><ul><li>First item</li><li>Second item</li></ul><ol><li>Step one</li><li>Step two</li></ol><blockquote><div>Quote me</div></blockquote><table border="1"><tr><td>Name</td><td>Value</td></tr><tr><td>Alpha</td><td>1</td></tr></table><div><en-todo checked="false"/>Write the plan</div><div><en-todo checked="true"/>Send invite</div><hr/><div>Signed: A&amp;B</div><en-media type="image/png" hash="2cd8bde463f5d82aae0f0cec061d6b8f"/></en-note>]]></content>
