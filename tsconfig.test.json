{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["DOM", "ES2020", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "out/t",
    "rootDir": ".",
    "sourceMap": false
  },
  "include": ["scripts/**/*.ts", "src/core/**/*.ts"]
}
